# MongoDB connection string
# Local:  mongodb://localhost:27017/aijobtracker
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/aijobtracker
MONGO_URI=mongodb://localhost:27017/aijobtracker

# Secret used to sign JWT auth tokens — use a long random string in production
JWT_SECRET=replace_this_with_a_long_random_string

# Port the API server listens on
PORT=5000

# URL of the frontend app — used to build links in emails, and to restrict CORS in production
CLIENT_URL=http://localhost:5173

# Gmail account used to send transactional emails (welcome, verification, password reset, reminders)
# EMAIL_USER is your full Gmail address.
# EMAIL_PASS is a 16-character Gmail "App Password" (NOT your normal Gmail password).
# Generate one at: https://myaccount.google.com/apppasswords (requires 2-Step Verification enabled)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_16_char_app_password
