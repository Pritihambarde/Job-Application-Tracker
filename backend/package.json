{
  "name": "ai-job-tracker-backend",
  "version": "1.0.0",
  "description": "Express + MongoDB API for Pipeline, a job application tracker with JWT auth, email notifications, and automated follow-up reminders.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest --runInBand",
    "test:watch": "jest --watch --runInBand",
    "test:coverage": "jest --coverage --runInBand"
  },
  "keywords": [
    "job-tracker",
    "express",
    "mongodb",
    "jwt-authentication",
    "rest-api"
  ],
  "author": "Priti",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "express-validator": "^7.3.2",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.7.0",
    "node-cron": "^4.4.1",
    "nodemailer": "^9.0.1"
  },
  "devDependencies": {
    "jest": "^30.4.2",
    "mongodb-memory-server": "^11.2.0",
    "nodemon": "^3.1.7",
    "supertest": "^7.2.2"
  }
}
